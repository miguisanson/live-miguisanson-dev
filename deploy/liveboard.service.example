[Unit]
Description=LiveBoard private multiplayer lobby
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_UBUNTU_USER
WorkingDirectory=/srv/miguisanson-dev
EnvironmentFile=/srv/miguisanson-dev/.env.local
Environment=LIVEBOARD_PORT=5000
ExecStart=/usr/bin/npm run game:start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
