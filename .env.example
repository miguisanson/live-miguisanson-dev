# PostgreSQL used by Better Auth. The default matches compose.yaml.
DATABASE_URL=postgresql://miguisanson:miguisanson_dev@localhost:5432/miguisanson_dev

# Generate both secrets with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
GAME_TICKET_SECRET=replace-with-at-least-32-random-characters

# The public lobby URL. Replace localhost with the stable game subdomain before deployment.
NEXT_PUBLIC_HERE_TO_SLAY_URL=http://localhost:5000/
HERE_TO_SLAY_AUTH_REQUIRED=true

# Verification and password reset emails log to the terminal during local development.
# Configure these in production to send real emails through Resend.
RESEND_API_KEY=
AUTH_EMAIL_FROM=miguisanson.dev <accounts@example.com>

# Optional bot protection. Configure both values together in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
