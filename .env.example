# Local Better Auth database. For production, replace this with DATABASE_URL for hosted PostgreSQL.
AUTH_SQLITE_PATH=.runtime/auth.sqlite

# Generate both secrets with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated browser origins that are allowed to call Better Auth.
BETTER_AUTH_TRUSTED_ORIGINS=
GAME_TICKET_SECRET=replace-with-at-least-32-random-characters

# The public lobby URL. Replace localhost with the stable game subdomain before deployment.
NEXT_PUBLIC_HERE_TO_SLAY_URL=http://localhost:5000/
HERE_TO_SLAY_AUTH_REQUIRED=true

# Verification and password reset emails log to the terminal during local development
# when neither Resend nor SMTP is configured.
# Use either Resend or SMTP.
RESEND_API_KEY=
AUTH_EMAIL_FROM=miguisanson.dev <accounts@miguisanson.dev>
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Optional bot protection. Configure both values together in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
